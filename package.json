{
  "name": "investidor-master",
  "version": "1.0.0",
  "description": "Projeto completo de landing page com backend e frontend",
  "main": "index.js",
  "scripts": {
    "install": "npm install --prefix backend && npm install --prefix frontend",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm start --prefix frontend",
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": "npm start --prefix backend",
    "start:frontend": "npm start --prefix frontend",
    "build": "npm run build:frontend",
    "build:frontend": "npm run build --prefix frontend"
  },
  "keywords": [
    "react",
    "express",
    "landing-page",
    "investimentos"
  ],
  "author": "Carlos Goodman",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  }
} 